# --- Project / API ---
PROJECT_NAME=ArchetypeCore
PROJECT_DESCRIPTION=Strict Clean Architecture Backend Template

# --- Database ---
# Required: Full database connection string
DATABASE_URL=sqlite+aiosqlite:///./test.db

# --- External Providers / Network Abstractions ---
# Required: IP and Public Key for the external provider
SERVER_IP=127.0.0.1
SERVER_PUBKEY=your_actual_server_public_key

# --- Security / JWT ---
# Required: Must be at least 32 characters
SECRET_KEY=replace_with_a_secure_random_string_of_at_least_32_chars

# --- Server ---
DEBUG=True

# --- Optional admin user for initial creation script ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=StrongP@ssw0rd!
ADMIN_ROLE=superadmin
